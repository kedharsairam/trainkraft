<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- API 33+ (Tiramisu) runtime permission; auto-granted on install below 33. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase D — travel-mode GPS (foreground-only).
         Runtime permissions since API 23; request both together and treat
         FINE as the precise grant (~API 31+ splits precise vs approximate).
         Background location (ACCESS_BACKGROUND_LOCATION) is deliberately NOT
         requested: travel mode only needs GPS while the tracking UI / service
         is in the foreground, so we sidestep the background grant (which on
         API 30+ is settings-only and triggers extra Play review) entirely. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Phase C — tracking foreground service.
         FOREGROUND_SERVICE is a normal (install-time) permission since API 28;
         FOREGROUND_SERVICE_LOCATION (API 34+, UpsideDownCake) is the matching
         type-specific declaration required when the service runs with
         foregroundServiceType="location". NOTE: the <service> entries
         themselves arrive with Phase C — permissions land here first. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Phase C — station/destination alarms.
         Special app-access since API 31: pre-31 it is granted at install, on
         API 31+ gate every exact-alarm call on
         AlarmManager.canScheduleExactAlarms() (user grants via Settings) and
         fall back to inexact alarms when denied.
         Deliberately NOT declared: USE_EXACT_ALARM (signature-level, not
         grantable to third-party apps) and REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         (no manifest entry — Phase C requests the ColorOS/OEM exemption via a
         Settings intent instead). Background location is likewise out of scope
         (see travel-mode note above). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Phase C — tracking foreground service (dataSync: NTES polling).
         The location type (Phase D travel-mode GPS) gets its own service
         entry later; this one never touches GPS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".TrainKraftApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrainKraft">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TrainKraft.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TrackingService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Phase D — travel-mode GPS (on-device fixes, foreground-only).
             Distinct service from TrackingService (which never touches GPS):
             this one runs with foregroundServiceType="location" and holds a
             10 s HIGH_ACCURACY fused request while a travel session is
             active. No background GPS ever (no background-location
             permission declared by design). -->
        <service
            android:name=".TravelService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.trainkraft.app.action.STATION_ALARM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
